[package]
name = "eva-gettext"
version = "0.4.0"
authors = ["Justinas Stankevicius <justinas@justinas.org>"]
description = "An implementation of Gettext translation framework for Rust"
license = "MIT"
readme = "README.md"
publish = false
edition = "2018"

[lib]
name = "gettext"

[dependencies]
byteorder = "1.3"
encoding_rs = "0.8.35"
